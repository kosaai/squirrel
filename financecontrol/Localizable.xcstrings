          }
        }
      }
    },
    "You can now select custom colors for categories. Your existing categories were updated to match the new look" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك الآن اختيار ألوان مخصصة للفئات. حُدّثت فئاتك الحالية لتتوافق مع المظهر الجديد."
          }
        }
      }
    },
    "You can perform quick actions like editing or deleting via swipe actions or by holding row" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تنفيذ إجراءات سريعة، مثل التعديل أو الحذف، عبر السحب أو الضغط مطولًا على الصف."
          }
        }
      }
    },
    "You can't undo this action." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكنك التراجع عن هذا الإجراء."
          }
        }
      }
    },
    "You can't undo this action.\nAll expenses from this category will be deleted" : {
      "localizations" : {
