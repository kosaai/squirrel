    "privacy-policy-fallback-key" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All expenses are stored locally by default. You can enable cloud synchronisation in settings, this way your expenses and categories will be stored in your iCloud storage in accordance with Apple privacy policy (https://apple.com/legal/privacy) and iCloud terms (https://www.apple.com/legal/internet-services/icloud)."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزَّن جميع المصروفات محليًا افتراضيًا. يمكنك تفعيل المزامنة السحابية من الإعدادات، وعندها ستُخزَّن مصروفاتك وفئاتك في مساحة تخزين iCloud وفقًا لسياسة خصوصية Apple (https://apple.com/legal/privacy) وشروط iCloud (https://www.apple.com/legal/internet-services/icloud)."
          }
        }
